# ==============================================================================
# NewsFlash Telegram Bot - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
# ==============================================================================

# Required: Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Required: Telegram User ID of the Master/Owner (integer)
ADMIN_USER_ID=0

# Optional: Master's personal blog URL and RSS feed (for ID=1 priority tracking)
MASTER_BLOG_URL=https://example.com/
MASTER_BLOG_RSS=https://example.com/rss.xml

# Optional: System Timezone (Default: Asia/Shanghai)
TIMEZONE=Asia/Shanghai

# Optional: SQLite Database Path (Default: ./rss_bot.db)
DB_PATH=rss_bot.db

# Optional: Companion Personas JSON Path (Default: ./personas.json)
PERSONAS_PATH=personas.json

# Optional: Background polling interval in minutes (Default: 30)
POLL_INTERVAL_MINUTES=30

# Optional: Daily evening digest schedule (Default: 22:00)
EVENING_DIGEST_HOUR=22
EVENING_DIGEST_MINUTE=0
